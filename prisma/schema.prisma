generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

model Role {
  roleId    String   @id @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  roleName  String   @unique @map("role_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  users User[] @relation("UserRoles")
}

model User {
  userId    String  @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  firstName String  @map("first_name")
  lastName  String? @map("last_name")
  email     String  @unique
  password  String

  role Role[] @relation("UserRoles")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String   @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @map("updated_by") @db.Uuid

  categoriesCreated  Category[]       @relation("CategoryCreatedBy")
  categoriesUpdated  Category[]       @relation("CategoryUpdatedBy")
  ingredientsCreated Ingredient[]     @relation("IngredientCreatedBy")
  ingredientsUpdated Ingredient[]     @relation("IngredientUpdatedBy")
  recipesCreated     Recipe[]         @relation("RecipeCreatedBy")
  recipesUpdated     Recipe[]         @relation("RecipeUpdatedBy")
  refresh_tokens     RefreshToken[]
  userIngredients    UserIngredient[]
  userRecipes        UserRecipe[]

  @@map("users")
}

model Category {
  categoryId       String                   @id @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  categoryName     String                   @map("category_name")
  parentCategoryId String?                  @map("parent_category_id") @db.Uuid
  category_type    String?
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String                   @map("created_by") @db.Uuid
  updatedAt        DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String                   @map("updated_by") @db.Uuid
  createdByUser    User                     @relation("CategoryCreatedBy", fields: [createdBy], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_created_by_users")
  parent           Category?                @relation("CategoryParent", fields: [parentCategoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction, map: "fk_parent_category")
  children         Category[]               @relation("CategoryParent")
  updatedByUser    User                     @relation("CategoryUpdatedBy", fields: [updatedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_updated_by_users")
  ingredientLinks  IngredientCategoryLink[]
  recipeCategories RecipeCategory[]

  @@index([parentCategoryId], map: "idx_categories_parent")
  @@map("categories")
}

model Ingredient {
  ingredientId      String                   @id @default(dbgenerated("gen_random_uuid()")) @map("ingredient_id") @db.Uuid
  ingredientName    String                   @map("ingredient_name")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String                   @map("created_by") @db.Uuid
  updatedAt         DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String                   @map("updated_by") @db.Uuid
  categoryLinks     IngredientCategoryLink[]
  createdByUser     User?                    @relation("IngredientCreatedBy", fields: [createdBy], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_ingredients_created_by_users")
  updatedByUser     User?                    @relation("IngredientUpdatedBy", fields: [updatedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_ingredients_updated_by_users")
  recipeIngredients RecipeIngredient[]
  userIngredients   UserIngredient[]

  @@index([createdBy], map: "idx_ingredients_created_by")
  @@index([updatedBy], map: "idx_ingredients_updated_by")
  @@map("ingredients")
}

model IngredientCategoryLink {
  ingredientId String     @map("ingredient_id") @db.Uuid
  categoryId   String     @map("category_id") @db.Uuid
  category     Category   @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade, onUpdate: NoAction, map: "fk_ingredientcategory_category")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade, onUpdate: NoAction, map: "fk_ingredientcategory_ingredient")

  @@id([ingredientId, categoryId])
  @@index([categoryId], map: "idx_ingredient_category")
  @@map("ingredient_category")
}

model Recipe {
  recipeId          String             @id @default(dbgenerated("gen_random_uuid()")) @map("recipe_id") @db.Uuid
  recipeName        String             @map("recipe_name")
  recipeDescription String?            @map("recipe_description")
  cookTime          Int                @map("cook_time")
  khau_phan         String?
  hinh_anh          String?
  difficulty        String             @default("0") @db.Char(1)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?            @map("created_by") @db.Uuid
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?            @map("updated_by") @db.Uuid
  recipeCategories  RecipeCategory[]
  ingredients       RecipeIngredient[]
  steps             RecipeStep[]
  userRecipes       UserRecipe[]
  createdByUser     User?              @relation("RecipeCreatedBy", fields: [createdBy], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipescreatedby_users")
  updatedByUser     User?              @relation("RecipeUpdatedBy", fields: [updatedBy], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipesupdatedby_users")

  @@index([createdBy], map: "idx_recipes_created_by")
  @@index([updatedBy], map: "idx_recipes_updated_by")
  @@map("recipes")
}

model Unit {
  unitId            String             @id @default(dbgenerated("gen_random_uuid()")) @map("unit_id") @db.Uuid
  unitName          String             @unique(map: "uq_units_name") @map("unit_name")
  symbol            String             @unique(map: "uq_units_symbol")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String             @map("created_by") @db.Uuid
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String             @map("updated_by") @db.Uuid
  recipeIngredients RecipeIngredient[]
  userIngredients   UserIngredient[]

  @@map("units")
}

model RecipeIngredient {
  recipeId     String     @map("recipe_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal    @db.Decimal
  unitId       String?    @map("unit_id") @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade, onUpdate: NoAction, map: "fk_ingredient")
  recipe       Recipe     @relation(fields: [recipeId], references: [recipeId], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipe")
  unit         Unit?      @relation(fields: [unitId], references: [unitId], onDelete: Restrict, onUpdate: NoAction, map: "fk_recipe_ingredients_unit")

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  stepId      String  @id @default(dbgenerated("gen_random_uuid()")) @map("step_id") @db.Uuid
  recipeId    String? @map("recipe_id") @db.Uuid
  stepNumber  Int     @map("step_number")
  description String
  recipe      Recipe? @relation(fields: [recipeId], references: [recipeId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipeId, stepNumber])
  @@map("recipe_steps")
}

model UserIngredient {
  userId       String     @map("user_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  quantity     Decimal?   @db.Decimal
  unitId       String?    @map("unit_id") @db.Uuid
  unit         Unit?      @relation(fields: [unitId], references: [unitId], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_ingredients_unit")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade, onUpdate: NoAction)
  user         User       @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, ingredientId])
  @@index([ingredientId], map: "idx_user_ingredients_ingredient")
  @@map("user_ingredients")
}

model RecipeCategory {
  recipeId   String @map("recipe_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  category Category @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipe_categories_category")
  recipe   Recipe   @relation(fields: [recipeId], references: [recipeId], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipe_categories_recipe")

  @@id([recipeId, categoryId])
  @@map("recipe_categories")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  users     User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_tokens_user")

  @@map("refresh_tokens")
}

model UserRecipe {
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [recipeId], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("user_recipes")
}
