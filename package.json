{
  "name": "backend-cockroach-ts",
  "version": "1.0.0",
  "description": "Node.js + TypeScript backend with CockroachDB, JWT auth (login/register), middleware",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec \"ts-node --files\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "cockroachdb",
    "prisma",
    "jwt",
    "auth"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "@types/send": "^0.17.4",
    "@types/serve-static": "^1.15.7",
    "nodemon": "^3.1.4",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
